# ── Navigation backend (backend/server/config.py) ──
# Any OpenAI-compatible chat-completions API. For the CGU LLM gateway set
# OPENAI_BASE_URL=https://air.cgu.edu.tw/cgullmapi/v1 and put the CGU key in OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
# Used when a call with OPENAI_API_KEY fails:
# OPENAI_BACKUP_KEY=

# Store maps (required for navigation)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Default store when a session names none:
# NEO4J_PLACE=A7家樂福（9/16)

# Skip the VLM's 3rd perception call (see backend/README.md)
VLM_PASS3=0
# 1 = local GroundingDINO / EasyOCR (needs model weights and easyocr + torch)
PERCEPTION_ENABLED=0
OCR_ENABLED=0

# ── Android app (read by app/build.gradle.kts) ──
# Navigation backend, e.g. http://192.168.x.x:8000/ (emulator default: http://10.0.2.2:8000/)
BACKEND_URL=
# The app's own LLM calls (shopping-list classification, receipts, AI screen) go through the CGU gateway
CGU_API_KEY=
CGU_BASE_URL=https://air.cgu.edu.tw/cgullmapi/v1
MAPS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
PADDLEOCR_ACCESS_TOKEN=
