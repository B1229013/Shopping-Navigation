MAPS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
PADDLEOCR_ACCESS_TOKEN=

# VLM backend selection: "openai" (default), "gemini", or "ollama"
VLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For real OpenAI, set OPENAI_API_KEY above and leave CGU_API_KEY empty so the
# base URL defaults to api.openai.com/v1. Uncomment to override explicitly:
# OPENAI_BASE_URL=https://api.openai.com/v1

# OCR backend: "openai" (gpt-4o-mini vision via /chat/completions, default) or
# "easyocr" (local EasyOCR engine — needs the easyocr + torch packages).
OCR_BACKEND=openai
# OCR model — defaults to OPENAI_MODEL (gpt-4o-mini); override only to differ.
# OPENAI_OCR_MODEL=gpt-4o-mini

# CGU LLM gateway (OpenAI-compatible: one key, many models via base-URL override).
# When CGU_API_KEY is set and OPENAI_API_KEY is empty, the VLM backend routes
# through the gateway automatically. Set OPENAI_MODEL to a gateway model id,
# e.g. gpt-5.4-mini or gpt-4o.
CGU_API_KEY=
CGU_BASE_URL=https://air.cgu.edu.tw/cgullmapi/v1
