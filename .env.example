# 複製這份檔案為 .env（同一層目錄），並填入你自己的金鑰。
# .env 已加入 .gitignore，不會被提交到 git。

# 選擇要用哪個 VLM 服務："gemini"（預設）、"openai"、或 "ollama"（本地端，不需金鑰）
VLM_BACKEND=openai

# --- VLM_BACKEND=openai 時使用（也相容任何 OpenAI 相容的 API，如自架/代理服務） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- VLM_BACKEND=gemini 時使用 ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- VLM_BACKEND=ollama 時使用（需先在本機安裝並執行 ollama serve） ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2-vision
